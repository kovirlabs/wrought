# Caddy as the front door for a Wrought build-mode site.
#
# Serves the engine's output folder directly: for build-only sites. For
# sites with publish routes, Caddyfile.publish (compose.publish.yml) passes
# misses to `engine serve`; see the Bloomery deployment spec.
#
# Local use: `docker compose -f deploy/compose.yml up -d` serves docs/public
# at http://127.0.0.1:8790/. For a real domain, replace `:80` with the domain
# (Caddy obtains a certificate automatically) and add the TLS settings and
# security headers of front-door.caddy (`import front-door.caddy` before the
# site, `import tls_modern` and `import security_headers` inside it), as
# Caddyfile.tls does for a site with publish routes.
{
	admin off
}

:80 {
	root * /srv/site

	# Dotfiles (.engine-manifest.json and any others) are never served.
	@hidden path /.* */.*
	respond @hidden 404
	# Nor are the engine's pre-compressed copies by their own names.
	@copies path_regexp \.(html?|css|m?js|svg|xml|rss|atom|json|map|webmanifest|txt|md|csv|ics)\.(br|gz)$
	respond @copies 404

	# Caching (DECISIONS.md, "Browser caching"): a refresh always shows an
	# edit. Content-hashed names (the segment before the extension is 8+
	# lowercase hex with a digit and a letter: site.3f2a9c1d0b.css; the
	# rule of engine_core::assets::is_fingerprinted) are kept for a year;
	# everything else is revalidated on every use, answered 304 from its
	# ETag (one per pre-compressed encoding, with Vary: Accept-Encoding).
	@hashed expression `{path}.matches("[.-][0-9a-f]{8,}[.][0-9A-Za-z]+$") && {path}.matches("[.-][0-9a-f]*[0-9][0-9a-f]*[.][0-9A-Za-z]+$") && {path}.matches("[.-][0-9a-f]*[a-f][0-9a-f]*[.][0-9A-Za-z]+$")`
	header @hashed Cache-Control "public, max-age=31536000, immutable"
	@unhashed not expression `{path}.matches("[.-][0-9a-f]{8,}[.][0-9A-Za-z]+$") && {path}.matches("[.-][0-9a-f]*[0-9][0-9a-f]*[.][0-9A-Za-z]+$") && {path}.matches("[.-][0-9a-f]*[a-f][0-9a-f]*[.][0-9A-Za-z]+$")`
	header @unhashed Cache-Control "no-cache"
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	# The engine writes a Brotli and a gzip copy beside every text file
	# (page.html.br, page.html.gz); Caddy sends the copy the browser takes,
	# with Vary: Accept-Encoding, and compresses nothing per request.
	file_server {
		precompressed br gzip
	}

	handle_errors {
		@notfound expression {err.status_code} == 404
		handle @notfound {
			rewrite * /404.html
			file_server {
				precompressed br gzip
			}
		}
	}
}
