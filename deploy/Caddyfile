# Caddy as the front door for a Wrought build-mode site.
#
# Serves the engine's output folder directly: for build-only sites. For
# sites with publish routes, Caddyfile.publish (compose.publish.yml) passes
# misses to `engine serve`; see the Bloomery deployment spec.
#
# Local use: `docker compose -f deploy/compose.yml up -d` serves docs/public
# at http://127.0.0.1:8790/. For a real domain, replace `:80` with the domain
# and Caddy obtains a certificate automatically.
{
	admin off
}

:80 {
	root * /srv/site

	# Dotfiles (.engine-manifest.json and any others) are never served.
	@hidden path /.* */.*
	respond @hidden 404
	# Nor are the engine's pre-compressed copies by their own names.
	@copies path_regexp \.(html?|css|m?js|svg|xml|rss|atom|json|map|webmanifest|txt|md|csv|ics)\.(br|gz)$
	respond @copies 404

	# HTML and other un-hashed documents: revalidate every time (a strong
	# ETag per encoding answers 304 when nothing changed).
	@documents path / */ *.html *.xml *.rss *.atom *.json *.txt
	header @documents Cache-Control "no-cache"

	# Vendored assets carry their version in the file name.
	header /_engine/tagbrush-* Cache-Control "public, max-age=31536000, immutable"
	header /_engine/tagaction-* Cache-Control "public, max-age=31536000, immutable"
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	# The engine writes a Brotli and a gzip copy beside every text file
	# (page.html.br, page.html.gz); Caddy sends the copy the browser takes,
	# with Vary: Accept-Encoding, and compresses nothing per request.
	file_server {
		precompressed br gzip
	}

	handle_errors {
		@notfound expression {err.status_code} == 404
		handle @notfound {
			rewrite * /404.html
			file_server {
				precompressed br gzip
			}
		}
	}
}
