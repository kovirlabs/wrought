// polkit rule: lets the engines' user (`hammerwright`) start and stop the
// sites' own PostgreSQL units, hammerwright-pg@<site>.service, and nothing else.
// Needed for a sleeping database with the systemd target of
// deploy/hammerwright-db-hook. Install as
//   /etc/polkit-1/rules.d/50-hammerwright-db-sleep.rules
polkit.addRule(function (action, subject) {
  if (action.id == "org.freedesktop.systemd1.manage-units" &&
      subject.user == "hammerwright") {
    var unit = action.lookup("unit");
    var verb = action.lookup("verb");
    if (unit && /^hammerwright-pg@[a-z0-9][a-z0-9-]*\.service$/.test(unit) &&
        (verb == "start" || verb == "stop")) {
      return polkit.Result.YES;
    }
  }
});
