# /etc/wrought/host.toml: settings of the hosting admin, not of a site's
# owner. Read by `engine serve` (path: ENGINE_HOST_CONFIG, default
# /etc/wrought/host.toml); nothing in a site's site.toml can change them.
# The environment variable ENGINE_IDLE_EXIT_SECONDS, set in the service
# unit, overrides both levels.

[defaults]
# Exit the engine after this many seconds without a request or a running
# job (0: never; the default). Needs socket activation
# (deploy/systemd/wrought-site@.socket) to come back on demand.
engine_idle_exit_seconds = 0

# Per site, by the site's ENGINE_SITE_ID (the systemd instance name).
# [sites.blog]
# engine_idle_exit_seconds = 300
