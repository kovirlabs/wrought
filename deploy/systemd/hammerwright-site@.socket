# Start on demand: systemd listens for the site and starts the engine on the
# first connection (socket activation; DECISIONS.md, "Start on demand").
# Published pages never need the engine: the front door (Caddy) serves them
# from the site's output folder, so a stopped engine costs nothing until a
# page rendered per request, a form post, the admin or a scheduled job
# needs it.
#
# One instance per site, named after its folder under /srv/hammerwright:
#   cp hammerwright-site@.socket hammerwright-site@.service hammerwright-wake@.service \
#      hammerwright-wake@.timer /etc/systemd/system/
#   mkdir /etc/systemd/system/hammerwright-site@blog.socket.d
#   printf '[Socket]\nListenStream=\nListenStream=127.0.0.1:4401\n' \
#     > /etc/systemd/system/hammerwright-site@blog.socket.d/port.conf
#   systemctl enable --now hammerwright-site@blog.socket hammerwright-wake@blog.timer
# and point the front door's ENGINE_UPSTREAM at 127.0.0.1:4401.
[Unit]
Description=Hammerwright engine socket for site %i

[Socket]
# Set per site in a drop-in (above); the default is only a placeholder.
ListenStream=127.0.0.1:4400
# A listening socket is passed (not one per connection): one engine
# process serves every connection.
Accept=no
NoDelay=true
Backlog=1024

[Install]
WantedBy=sockets.target
