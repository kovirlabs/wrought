---
import Base from "../../layouts/Base.astro";
import { articles } from "../../articles.js";
export function getStaticPaths({ paginate }) {
  return paginate(articles, { pageSize: 10 });
}
const { page } = Astro.props;
---
<Base title="Articles">
<h1>Articles</h1>
<ul>{page.data.map((a) => (<li><a href={`/articles/${a.slug}/`}>{a.frontmatter.title}</a></li>))}</ul>
<nav aria-label="Pages"><ul>
{page.url.prev && <li><a href={page.url.prev}>Previous</a></li>}
{page.url.next && <li><a href={page.url.next}>Next</a></li>}
</ul></nav>
</Base>
