<% content_for :title, @article.title %>
<% bench_cache(["article", @article]) do %>
<article>
<nav aria-label="Breadcrumbs"><ol><li><a href="/">Home</a></li><li><a href="/articles/">Articles</a></li></ol></nav>
<h1><%= @article.title %></h1>
<p><small><time datetime="<%= @article.published_at.to_date.iso8601 %>"><%= @article.published_at.strftime("%-d %B %Y") %></time><% if @article.author %> · by <%= @article.author.name %><% end %></small></p>
<%= raw @article.body_html %>
<% if @article.topics.any? %>
<p>Topics: <%= safe_join(@article.topics.map { |t| link_to(t.name, topic_path(t.slug)) }, ", ") %></p>
<% end %>
</article>
<% related = @article.related %>
<% if related.any? %>
<section aria-labelledby="related-title">
<h2 id="related-title">More on these topics</h2>
<ul><% related.each do |r| %><li><a href="<%= article_path(r) %>"><%= r.title %></a></li><% end %></ul>
</section>
<% end %>
<% end %>
