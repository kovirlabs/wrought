<% content_for :title, "Search" %>
<h1>Search</h1>
<form action="/search/" method="get" role="search">
<label for="q">Search for</label>
<input id="q" name="q" type="search" value="<%= @q %>">
<button type="submit">Search</button>
</form>
<% if @q.present? %>
<p role="status"><%= @results.size %> result<%= "s" unless @results.size == 1 %> for “<%= @q %>”</p>
<ol><% @results.each do |a| %><li><a href="<%= article_path(a) %>"><%= a.title %></a><p><%= a.summary %></p></li><% end %></ol>
<% end %>
